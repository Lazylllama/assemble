<div class="flex flex-row gap-8">
    <%= render FieldComponent.new(type: :text, placeholder: "T.ex Alva") %>
    <%= render FieldComponent.new(type: :select, placeholder: "Välj klass") do
        tag.option("Välj klass", value: "", disabled: true, selected: true, hidden: true) +
