<%# Same grid as Figma: one row per style, one column per state. %>
<div class="grid grid-cols-[auto_auto_auto] items-center gap-x-6 gap-y-4">
  <span></span>
  <% states.each_key do |state| %>
    <span class="font-mono text-t1 text-fg-3"><%= state %></span>
  <% end %>

  <% styles.each do |style| %>
    <span class="font-mono text-t1 text-fg-3"><%= style.to_s.humanize %></span>
    <% states.each_value do |disabled| %>
      <div><%= render ButtonComponent.new(style: style, disabled: disabled).with_content("Skicka anmälan") %></div>
    <% end %>
  <% end %>

  <span class="font-mono text-t1 text-fg-3">Block</span>
  <% states.each_value do |disabled| %>
    <div><%= render ButtonComponent.new(size: :block, disabled: disabled, class: "w-90").with_content("Skicka anmälan") %></div>
  <% end %>
</div>
