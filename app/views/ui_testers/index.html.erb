<% content_for :title, "UI Kit" %>

<div class="mx-auto max-w-6xl px-5 py-12">
  <h1 class="font-display text-t7">UI Kit</h1>
  <p class="mt-2 text-t3 text-fg-2">
    <%= render ButtonComponent.new(style: :text, href: "https://www.figma.com/design/4LuZXDL2hDihFSI4aLYzYl/LBS-Tjofs?node-id=203-136&p=f&m=dev%").with_content("Link to figma") %>
  </p>

  <% @sections.each do |section, names| %>
    <section class="mt-12">
      <h2 class="border-b border-line pb-2 font-display text-t6"><%= section %></h2>

      <% names.each do |name| %>
        <div class="mt-6">
          <h3 class="font-mono text-t3 text-fg"><%= name %>Component</h3>

          <% if (preview = @previews[name]) %>
            <div class="mt-3 flex flex-wrap items-start gap-6">
              <% preview_examples(preview).each do |example| %>
                <figure class="flex flex-col gap-2">
                  <figcaption class="font-mono text-t1 text-fg-3"><%= example.humanize %></figcaption>
                  <%= render_preview_example(preview, example) %>
                </figure>
              <% end %>
            </div>
          <% else %>
            <p class="mt-2 font-mono text-t2 text-fg-3">
              Ingen preview än. Skapa test/components/previews/<%= name.underscore %>_component_preview.rb
            </p>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
